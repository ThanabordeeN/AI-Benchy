{
  "name": "ai-benchy",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "neu:update": "neu update",
    "neu:dev": "concurrently -k -s first \"next dev\" \"wait-on -t 30000 http-get://127.0.0.1:3000 && neu run\"",
    "neu:browser": "concurrently -k -s first \"next dev\" \"wait-on -t 30000 http-get://127.0.0.1:3000 && neu run --mode=browser\"",
    "neu:build": "node scripts/build-binary.js",
    "neu:start": "cd dist/ai-benchy && ./ai-benchy-linux_x64",
    "app": "./run-app.sh",
    "neu:version": "neu version"
  },
  "dependencies": {
    "@neutralinojs/lib": "^6.9.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@neutralinojs/neu": "^11.7.2",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.3.3",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "wait-on": "^9.1.0"
  }
}
